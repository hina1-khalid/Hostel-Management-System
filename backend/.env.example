# Copy this file to ".env" and fill in your values. Never commit .env.
PORT=5000

# MongoDB Atlas: Connect -> Drivers -> copy the string (replace <username>/<password>)
# Local MongoDB also works: mongodb://127.0.0.1:27017/hostel_management
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hostel_management?retryWrites=true&w=majority

# Any long random string
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend URL(s) for CORS, comma separated
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# Time zone used for "today", curfew and late-entry checks
APP_TIMEZONE=Asia/Karachi
CURFEW_HOUR=22

# Default mess charge per meal (Rs)
MESS_RATE_PER_MEAL=150

# Optional: enables the real AI chatbot (without it, a built-in rule-based assistant answers)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Email notifications (optional) ----
# Leave SMTP_HOST empty to disable email; in-app notifications keep working.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#   SMTP_PASS=<16-character Google "App Password" (Google Account -> Security -> 2-Step Verification -> App passwords)>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hostel Management <you@gmail.com>"
